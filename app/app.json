{
  "expo": {
    "name": "Drink To You",
    "slug": "drink-to-you",
    "scheme": "drinktoyou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drinktoyou.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.drinktoyou.app",
      "adaptiveIcon": {
        "backgroundColor": "#102B46",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Drink To You usa sua localização apenas para mostrar o clima da sua cidade."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#102B46"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ec875cd-c034-4291-9bff-5babb969973e"
      }
    },
    "owner": "cyberr01",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0ec875cd-c034-4291-9bff-5babb969973e"
    }
  }
}
