# ===== Dependências (apenas pastas reais de pacotes, sem afetar assets estáticos do PWA) =====
/node_modules/
app/node_modules/
api/node_modules/

# ===== Variáveis de ambiente e segredos (NUNCA versionar) =====
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# ===== Banco de dados local =====
*.db
*.sqlite
*.sqlite3

# ===== Builds e artefatos =====
app/dist/
/build/
app/build/
api/build/
web-build/
*.apk
*.aab
*.ipa

# Garante que todos os assets estáticos do PWA (fontes .ttf e ícones) sejam versionados
!api/public/**

# ===== Expo / React Native =====
.expo/
.expo-shared/
app/android/
app/ios/

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Sistema operacional =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== Editores / IDEs =====
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ===== Testes e cache =====
coverage/
.cache/
.eslintcache
*.tsbuildinfo
