# Copie este arquivo para ".env" e preencha. NUNCA versione o ".env".

PORT=3000

# Connection string do Postgres (Supabase > Project Settings > Database > Session pooler)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Segredo usado para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=7d
